# Copy to .env and fill in. The app no longer uses SQLite in production; use Neon, Supabase, or any Postgres.
#
# Free Postgres: https://neon.tech — create a project, copy the connection string.
# Use a direct (non-pooled) URL for `DATABASE_URL` if `prisma migrate deploy` ever fails on your host; otherwise a pooled Neon's URL is usually fine.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="use-a-long-random-string-at-least-32-chars"
