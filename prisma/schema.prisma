generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  feedEvents   FeedEvent[]
  arenaCreated Arena[]        @relation("ArenaCreator")
  arenaMembers ArenaMember[]
  arenaStockVotes ArenaStockVote[]
  following    Follow[]       @relation("Following")
  followers    Follow[]       @relation("Follower")
  arenaMessages ArenaMessage[]
  directMessagesSent DirectMessage[] @relation("DirectMessageSender")
  directMessagesReceived DirectMessage[] @relation("DirectMessageRecipient")
  conversationsCreated Conversation[] @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[]
  conversationMessages ConversationMessage[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdings Holding[]
  feed     AccountFeedEvent[]

  @@index([userId])
}

model Holding {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  symbol   String
  name     String
  shares   Float
  lastPrice  Float? // per share, used for value
  marketCap  Float? // company market cap in USD
  marketCapText String? // e.g. "1.2T" from quote

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, symbol])
}

/// Site-wide event stream: position changes (one row per user holding transaction)
model FeedEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol   String
  title    String
  /// NEW | INCREASE | REDUCE | CLOSE
  kind     String
  /// Position-relative 0–100% for this line only
  pct      Float
  oldShares Float
  newShares Float
  accountName String? // for context: which account, optional

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Per-account feed; same % semantics, not shown in arena
model AccountFeedEvent {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  symbol   String
  title    String
  kind     String
  pct      Float
  oldShares Float
  newShares Float

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([createdAt])
}

model Arena {
  id          String   @id @default(cuid())
  name        String
  joinCode    String   @unique
  createdById String
  createdBy   User     @relation("ArenaCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members ArenaMember[]
  messages ArenaMessage[]
  stockVotes ArenaStockVote[]

  @@index([joinCode])
}

/// Per-member conviction vote on a ticker inside an arena (1 = Strong Sell … 5 = Strong Buy).
model ArenaStockVote {
  id        String   @id @default(cuid())
  arenaId   String
  userId    String
  symbol    String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([arenaId, userId, symbol])
  @@index([arenaId, symbol])
}

model ArenaMember {
  id        String   @id @default(cuid())
  arenaId   String
  userId    String
  joinedAt  DateTime @default(now())
  lastReadChatAt DateTime?
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([arenaId, userId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model ArenaMessage {
  id        String   @id @default(cuid())
  arenaId   String
  senderId  String
  body      String
  shareUrl  String?
  createdAt DateTime @default(now())

  arena  Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([arenaId, createdAt])
  @@index([senderId, createdAt])
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  shareUrl    String?
  createdAt   DateTime @default(now())

  sender    User @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model Conversation {
  id          String   @id @default(cuid())
  name        String?
  isGroup     Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  createdBy    User @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     ConversationMessage[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  shareUrl       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

/// Cached quarterly fundamentals / extras for chart trends (merge with live Yahoo on read).
model TrendsQuarterSnapshot {
  id        String   @id @default(cuid())
  symbol    String
  atMs      BigInt
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, atMs])
  @@index([symbol])
}
